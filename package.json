{
  "name": "@dsh-external/dsh-scientific-reading",
  "version": "0.0.1",
  "description": "文献工作流：下载(scansci-pdf)→解析→浅读→入库(本地库)→飞书",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "scripts/scansci_wrap.py",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dshCompatibility": {
    "testedHost": "0.1.0-rc.7",
    "node": "22",
    "python": "3.11"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "24.13.3",
    "cordis": "npm:@deepseek-ai/cordis@4.0.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:ci": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test:bundle": "node tests/bundle-contract.mjs",
    "test:client": "node tests/client-build.mjs",
    "test:client-ui": "node tests/client-ui-contract.mjs",
    "test:compat": "node tests/dsh-compat.mjs",
    "test:package": "node tests/package-contents.mjs",
    "test:profile-bundle": "node tests/profile-bundle-verifier.mjs",
    "test:profile-runtime": "node tests/profile-runtime-verifier.mjs",
    "test:reading-routes": "node tests/reading-routes.mjs",
    "test:offline": "node tests/client-build.mjs && node tests/client-ui-contract.mjs && node tests/dsh-compat.mjs && node tests/bundle-contract.mjs && node tests/package-contents.mjs && node tests/profile-bundle-verifier.mjs && node tests/profile-runtime-verifier.mjs && node tests/reading-routes.mjs && node tests/two-stage-ingest.mjs && node tests/phase1-plugin-contract.mjs && node tests/library-navigation-api.mjs && node tests/restart-recovery-pid-safety.mjs && node tests/ci-workflow.mjs && node tests/harness.mjs && node tests/feishu-env-only.mjs && node scripts/plugin-check.mjs",
    "verify:profile-bundle": "node scripts/verify-profile-bundle.mjs",
    "verify:profile-runtime": "node scripts/verify-profile-runtime.mjs",
    "verify:restart-recovery": "python scripts/verify_restart_recovery.py",
    "test:foundation": "node tests/foundation-integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
